{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.1",
      "excludeFiles": "{assets/**,ref/**}"
    }
  },
  "routes": [
    {
      "src": "/data-siswa",
      "dest": "/api/export_csv.php"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
